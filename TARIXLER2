--TASK1
SELECT FIRST_NAME, SUBSTR(UPPER(FIRST_NAME),1,2) || '-' || SUBSTR(LOWER(LAST_NAME),1,3) AS KOD_AD,
REPLACE(PHONE_NUMBER,'.','') AS TELEFON_TEMIZ, LENGTH(FIRST_NAME) + LENGTH(LAST_NAME) AS AD_UZUNLUQ 
FROM HR.EMPLOYEES
ORDER BY AD_UZUNLUQ ASC
--TASK2
SELECT FIRST_NAME, SALARY, NVL2(COMMISSION_PCT,(COMMISSION_PCT*100) || '%','TEYIN EDILMEYIB'), 
TO_CHAR(SALARY*NVL(COMMISSION_PCT,0),'$999,990.00')
FROM HR.EMPLOYEES
WHERE SALARY>5000
ORDER BY SALARY ASC;
--TASK3
SELECT CONCAT(CONCAT(FIRST_NAME,' '),LAST_NAME) ,TO_CHAR(HIRE_DATE,'DDD'), TO_CHAR(HIRE_DATE,'Q')
FROM HR.EMPLOYEES
--TASK4
SELECT FIRST_NAME, TO_CHAR(HIRE_DATE,'DD-Mon-YYYY') AS ISE_GIRIS,
 NEXT_DAY(HIRE_DATE,'MONDAY') AS TELIM_TARIXI, NEXT_DAY(HIRE_DATE,'MONDAY')-HIRE_DATE
 FROM HR.EMPLOYEES
 WHERE JOB_ID IN ('IT_PROG','SA_REP');
--TASK5 TARICDEN TARIX CIXMAQ OLMUR
SELECT TRUNC(MONTHS_BETWEEN(SYSDATE,TO_DATE('15.10.1998','DD.MM.YYYY'))/12) FROM DUAL
SELECT TO_CHAR(ADD_MONTHS(TO_DATE('31.01.2025','DD.MM.YYYY'),1),'DD.MM.YYYY') FROM DUAL
--TASK6 
SELECT FIRST_NAME,TO_CHAR(SALARY,'99,999'),TO_CHAR(HIRE_DATE,'HH24') AS SAAT FROM HR.EMPLOYEES
WHERE TO_CHAR(HIRE_DATE,'FMMonth')='May';
--TASK7
SELECT DEPARTMENT_ID, COUNT(*) AS ISCI_SAYI, TO_CHAR(MIN(HIRE_DATE),'DD.MM.YYYY') AS ILK_ISCI_TARIX,
TO_CHAR(MAX(HIRE_DATE),'DD.MM.YYYY'), TRUNC(MAX(HIRE_DATE)-MIN(HIRE_DATE)) AS GUN_FERQI
FROM HR.EMPLOYEES
GROUP BY DEPARTMENT_ID
HAVING DEPARTMENT_ID IS NOT NULL
ORDER BY DEPARTMENT_ID DESC;
--TASK8
SELECT 'EMP' || CONCAT('-',LPAD(EMPLOYEE_ID,5,'0')) || '-' || CONCAT(SUBSTR(UPPER(FIRST_NAME),1,1),SUBSTR(UPPER(LAST_NAME),1,1)) AS KART_NO,
LENGTH(EMAIL) AS EMAIL_UZUNLUQ,INSTR(LAST_NAME,'a') AS ILK_A_HERFI FROM HR.EMPLOYEES
WHERE INSTR(LAST_NAME,'a')>0
--TASK9
SELECT TO_CHAR(HIRE_DATE,'Q') AS ILIN_RUBU, TO_CHAR(HIRE_DATE,'MM') AS AY_NO, TO_CHAR(HIRE_DATE,'FMMonth') AS AY_ADI,
COUNT(*) AS ISCI_SAYI, TO_CHAR(SUM(SALARY),'$999,999')
FROM HR.EMPLOYEES
GROUP BY TO_CHAR(HIRE_DATE,'Q'), TO_CHAR(HIRE_DATE,'MM'),TO_CHAR(HIRE_DATE,'FMMonth')
ORDER BY TO_CHAR(HIRE_DATE,'Q') ASC,
TO_CHAR(HIRE_DATE,'MM') ASC;
--TASK10
--A)
SELECT FIRST_NAME,HIRE_DATE,TO_CHAR(TRUNC(HIRE_DATE,'YEAR'),'DD.MM.YYYY') AS ILIN_ILK_GUNU,
TO_CHAR(ADD_MONTHS(TRUNC(HIRE_DATE,'YEAR'),12)-1,'DD.MM.YYYY') AS ILIN_SON_GUNU,
ADD_MONTHS(TRUNC(HIRE_DATE,'YEAR'),12)-1 -TRUNC(HIRE_DATE) AS ILE_QALAN_GUN
FROM HR.EMPLOYEES;
--B) HIRE DATE DE 00:00:00 OLUR SAAT AMMA SYS DATE DE DEQIQ SAATI QAYTARIR
SELECT * FROM HR.EMPLOYEES
WHERE TRUNC(HIRE_DATE)=TRUNC(SYSDATE);
