SELECT * FROM HR.EMPLOYEES;
SELECT FIRST_NAME , LAST_NAME , HIRE_DATE, SALARY , NVL(COMMISSION_PCT,0) AS DUZELDILMIS_KOMISSIYA FROM HR.EMPLOYEES;
--TASK2
SELECT LAST_NAME , FIRST_NAME , SALARY FROM HR.EMPLOYEES
WHERE UPPER(LAST_NAME) LIKE 'KING';
--TASK3
SELECT HIRE_DATE , FIRST_NAME , LAST_NAME FROM HR.EMPLOYEES
WHERE HIRE_DATE > TO_DATE ('1/1/2006' , 'DD/MM/YYYY'); 
--TASK4**
SELECT FIRST_NAME , LAST_NAME , ROUND(SYSDATE - HIRE_DATE) AS STAZ_AY FROM HR.EMPLOYEES;
--TASK5
SELECT FIRST_NAME , LAST_NAME , PHONE_NUMBER FROM HR.EMPLOYEES
WHERE PHONE_NUMBER LIKE '1.515%';
--TASK6
SELECT * FROM HR.JOBS;
SELECT MIN_SALARY , JOB_TITLE FROM HR.JOBS
WHERE MIN_SALARY <3000
ORDER BY MIN_SALARY DESC;
--TASK 7
SELECT *FROM HR.LOCATIONS
SELECT POSTAL_CODE , CITY , STREET_ADDRESS FROM HR.LOCATIONS
WHERE POSTAL_CODE IS NULL;
--TASK8
SELECT FIRST_NAME , LAST_NAME , SALARY||'USD' AS MAAS_VALYUTA FROM HR.EMPLOYEES;
--TASK9
SELECT COUNT(*) AS BUTUN_VEZIFE FROM HR.JOBS
WHERE MAX_SALARY>20000;
--TASK10
SELECT FIRST_NAME , HIRE_DATE FROM HR.EMPLOYEES
WHERE HIRE_DATE >= DATE '2005-01-01' AND HIRE_DATE <= DATE '2005-12-31';
SELECT FIRST_NAME , HIRE_DATE FROM HR.EMPLOYEES
WHERE HIRE_DATE BETWEEN TO_DATE ('2005-01-01' , 'YYYY-MM-DD') AND TO_DATE('2005-12-31' , 'YYYY-MM-DD');
 SELECT FIRST_NAME , HIRE_DATE FROM HR.EMPLOYEES
 WHERE EXTRACT(YEAR FROM HIRE_DATE)=2005;
 --TASK11
 SELECT FIRST_NAME , SALARY , ROUND(SALARY*0.80 , 2) AS NET_MAAS FROM HR.EMPLOYEES;
 --TAK12
SELECT FIRST_NAME , HIRE_DATE , JOB_ID FROM HR.EMPLOYEES
WHERE (HIRE_DATE >=DATE'2003-01-01') AND (HIRE_DATE<=DATE'2005-12-31') AND JOB_ID <> 'IT_PROG';
SELECT FIRST_NAME , HIRE_DATE , JOB_ID FROM HR.EMPLOYEES
WHERE HIRE_DATE BETWEEN TO_DATE('2003-01-01','YYYY-MM-DD') AND TO_DATE('2005-12-31','YYYY-MM-DD');
--TASK13
SELECT ROUND(AVG(SALARY)),COUNT(*) AS KOMISIYA_ALMIYAN FROM HR.EMPLOYEES
WHERE COMMISSION_PCT IS NOT NULL;
--TASK14
SELECT FIRST_NAME , MANAGER_ID , DEPARTMENT_ID , SALARY FROM HR.EMPLOYEES
ORDER BY SALARY DESC FETCH FIRST 3 ROWS ONLY;
--TASK15
SELECT FIRST_NAME , LAST_NAME , HIRE_DATE FROM HR.EMPLOYEES
WHERE EXTRACT(MONTH FROM HIRE_DATE)=15 AND SALARY BETWEEN 5000 AND 12000;
--TASK16
SELECT FIRST_NAME , LAST_NAME , JOB_ID FROM HR.EMPLOYEES
WHERE LOWER(FIRST_NAME) LIKE 'david';
--TASK17
SELECT FIRST_NAME , LAST_NAME , HIRE_DATE FROM HR.EMPLOYEES
WHERE HIRE_DATE<=DATE'2007-12-31';
--TASK18
SELECT * FROM HR.LOCATIONS;
SELECT POSTAL_CODE , CITY  FROM HR.LOCATIONS
WHERE POSTAL_CODE LIKE '9%';
--TASK19
SELECT MAX_SALARY , JOB_TITLE FROM HR.JOBS
WHERE MAX_SALARY>10000
ORDER BY MAX_SALARY DESC;
--TASK20
SELECT MANAGER_ID , DEPARTMENT_NAME FROM HR.DEPARTMENTS
WHERE MANAGER_ID IS NOT NULL;
--TASK21
SELECT FIRST_NAME, DEPARTMENT_ID||'DEPT' FROM HR.EMPLOYEES;
--TASK22
SELECT COUNT(*) FROM HR.EMPLOYEES
WHERE JOB_ID='ST_CLERK';
 --TASK23
SELECT FIRST_NAME , HIRE_DATE FROM HR.EMPLOYEES
WHERE EXTRACT(YEAR FROM HIRE_DATE)=2008 AND EXTRACT(MONTH FROM HIRE_DATE)=1;
SELECT FIRST_NAME , HIRE_DATE FROM HR.EMPLOYEES
WHERE HIRE_DATE >= TO_DATE('2008-01-01' , 'YYYY-MM-DD')
AND HIRE_SDATE < TO_DATE('2008-02-01', 'YYYY-MM-DD')
--TASK24
SELECT FIRST_NAME , LAST_NAME , COMMISSION_PCT FROM HR.EMPLOYEES
WHERE COMMISSION_PCT >= 0.15;
--TASK25
SELECT JOB_TITLE , MAX_SALARY FROM HR.JOBS
ORDER BY MAX_SALARY DESC FETCH FIRST 3 ROWS ONLY;
--TASK26
SELECT FIRST_NAME , SALARY , SALARY*(0.10+NVL(COMMISSION_PCT,0)) AS BONUS FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID=80;
--TASK27
SELECT FIRST_NAME , LAST_NAME , HIRE_DATE FROM HR.EMPLOYEES
WHERE EXTRACT(MONTH FROM HIRE_DATE)=6 AND EXTRACT(YEAR FROM HIRE_DATE)>2004;
--TASK28
SELECT COUNT(*) , MAX(SALARY) , MIN(SALARY) , ROUND(AVG(SALARY),0) AS ORTA_MAASH FROM HR.EMPLOYEES;
--TASK29
SELECT FIRST_NAME , ROUND((SALARY*12),2) AS ILLIK_BRUTO, ROUND((SALARY*12)*0.15,2) AS ILLIK_VERGI , ROUND((SALARY*12)*0.85,2) AS ILLIK_NET FROM HR.EMPLOYEES;
