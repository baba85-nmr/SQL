--TASK1
SELECT E.FIRST_NAME, E.LAST_NAME, M.FIRST_NAME AS MENECER_ADI, M.LAST_NAME AS MENECER_SOYADI
 FROM HR.EMPLOYEES E 
JOIN HR.EMPLOYEES M ON E.MANAGER_ID=M.EMPLOYEE_ID;
--TASK2 LEFT TASK 1 DE 106 SETIR TASK 2 DE 107 SETIR CIKDI IKINCIDE LEFT YAZDIQ EMPLOY
-- CEDVELI SOLDADIR VE SOLDAKI IS,ILERI SAXLADI MENECERI OLMASA BELE.
SELECT E.FIRST_NAME, E.LAST_NAME, M.FIRST_NAME AS MENECER_ADI, M.LAST_NAME AS MENECER_SOYADI 
FROM HR.EMPLOYEES E 
LEFT JOIN HR.EMPLOYEES M ON M.EMPLOYEE_ID =E.MANAGER_ID;
--TASK3
SELECT FIRST_NAME, LAST_NAME, DEPARTMENT_ID FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IN (SELECT DEPARTMENT_ID FROM HR.DEPARTMENTS
WHERE LOCATION_ID=1700);
--TASK4
SELECT E.FIRST_NAME, E.LAST_NAME FROM HR.EMPLOYEES E
JOIN HR.EMPLOYEES M ON M.EMPLOYEE_ID=E.MANAGER_ID
WHERE M.FIRST_NAME='Steven' AND M.LAST_NAME='King';
--TASK5
SELECT E.FIRST_NAME, E.LAST_NAME, E.SALARY,M.FIRST_NAME AS MENECER_ADI,M.SALARY AS MENECER_MAASI 
FROM HR.EMPLOYEES E 
JOIN HR.EMPLOYEES M ON M.EMPLOYEE_ID=E.MANAGER_ID 
WHERE M.SALARY<E.SALARY;
--TASK6
SELECT E.FIRST_NAME, E.LAST_NAME, E.DEPARTMENT_ID, M.FIRST_NAME AS MENECER_ADI, M.DEPARTMENT_ID MENECER_SOBESI
FROM HR.EMPLOYEES E 
JOIN HR.EMPLOYEES M ON E.MANAGER_ID=M.EMPLOYEE_ID
WHERE E.DEPARTMENT_ID<>M.DEPARTMENT_ID;
--TASK7
SELECT FIRST_NAME, LAST_NAME, JOB_ID, SALARY FROM HR.EMPLOYEES
WHERE JOB_ID IN (SELECT JOB_ID FROM HR.JOBS
WHERE MIN_SALARY>=10000)
--TASK8 1 CI SEHV = ISARESI OLMAZ O ZAMAN 1 SUTUN VERIR IN YAZILIR
--2 CI SEHV MORTERIZEDE 2 SUTUN YAZILIB SELECTDEN SONRA 3 CU SEHV 
--SALESI HAMISINI BALACA ILE YAZIB XETA VERMIYECEY AMMA NO ITEM YAZILACAQ 
SELECT FIRST_NAME, LAST_NAME FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IN (SELECT DEPARTMENT_ID FROM HR.DEPARTMENTS
WHERE DEPARTMENT_NAME IN ('IT','Sales'));
--TASK9
SELECT EMPLOYEE_ID, FIRST_NAME, LAST_NAME FROM HR.EMPLOYEES
WHERE EMPLOYEE_ID IN (SELECT MANAGER_ID FROM HR.EMPLOYEES
WHERE MANAGER_ID IS NOT NULL);
--2CI USUL
SELECT E.EMPLOYEE_ID, E.FIRST_NAME, E.LAST_NAME FROM HR.EMPLOYEES E 
JOIN HR.EMPLOYEES M ON E.MANAGER_ID=M.EMPLOYEE_ID
GROUP BY E.EMPLOYEE_ID, E.FIRST_NAME, E.LAST_NAME, E.MANAGER_ID
HAVING E.MANAGER_ID IS NOT NULL

--TASK10
SELECT M.FIRST_NAME AS MENECER_ADI, M.LAST_NAME AS MENECER_SOYADI, COUNT(*) AS TABE_SAYI, ROUND(AVG(E.SALARY)) AS TABELERIN_ORTA_MAASI
FROM HR.EMPLOYEES E
JOIN HR.EMPLOYEES M ON M.EMPLOYEE_ID=E.MANAGER_ID
GROUP BY M.FIRST_NAME, M.LAST_NAME
HAVING COUNT(*)>5
ORDER BY TABE_SAYI DESC;
