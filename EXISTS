--TASK1
SELECT E.FIRST_NAME, E.LAST_NAME, E.DEPARTMENT_ID FROM HR.EMPLOYEES E
WHERE EXISTS(SELECT 1 FROM HR.DEPARTMENTS D
            WHERE D.DEPARTMENT_ID=E.DEPARTMENT_ID AND
             D.DEPARTMENT_NAME IN ('MARKETING','PURCHASING','IT'));
SELECT FIRST_NAME,LAST_NAME,DEPARTMENT_ID FROM HR.EMPLOYEES 
WHERE DEPARTMENT_ID IN(SELECT DEPARTMENT_ID FROM HR.DEPARTMENTS 
        WHERE DEPARTMENT_NAME IN ('MARKETING','PURCHASING','IT'));
--TASK2
        SELECT m.EMPLOYEE_ID, m.FIRST_NAME, m.LAST_NAME
FROM HR.EMPLOYEES m
WHERE EXISTS (
    SELECT 1
    FROM HR.EMPLOYEES e
    WHERE e.MANAGER_ID = m.EMPLOYEE_ID
);
--TASK3
SELECT TO_CHAR(TO_DATE('2026/12/31','YYYY/MM/DD'),'DD.MM.YYYY HH24:MI'),
