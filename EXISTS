--TASK7
SELECT FIRST_NAME, LAST_NAME, HIRE_DATE FROM HR.EMPLOYEES
WHERE HIRE_DATE>= TO_DATE('01.07.2006','DD.MM.YYYY') AND
HIRE_DATE<=TO_DATE('31.12.2006','DD.MM.YYYY')
ORDER BY HIRE_DATE ASC;
SELECT FIRST_NAME, LAST_NAME, HIRE_DATE FROM HR.EMPLOYEES
WHERE HIRE_DATE BETWEEN  TO_DATE('01.07.2006','DD.MM.YYYY') AND
TO_DATE('31.12.2006','DD.MM.YYYY');
--TASK8
SELECT d.DEPARTMENT_ID, d.DEPARTMENT_NAME
FROM HR.DEPARTMENTS d
WHERE EXISTS (SELECT 1 FROM HR.EMPLOYEES e
    WHERE e.DEPARTMENT_ID = d.DEPARTMENT_ID
      AND e.HIRE_DATE >= DATE '2007-01-01'
);
SELECT D.DEPARTMENT_ID,D.DEPARTMENT_NAME FROM HR.DEPARTMENTS D
WHERE D.DEPARTMENT_ID IN(SELECT D.DEPARTMENT_ID FROM HR.EMPLOYEES E
                            WHERE DEPARTMENT_ID IS NOT NULL AND
                            E.HIRE_DATE>=DATE '2007-01-01')
--TASK9
SELECT FIRST_NAME, HIRE_DATE
FROM HR.EMPLOYEES E
WHERE HIRE_DATE >= TO_DATE('15/03/2006', 'DD/MM/YYYY')
  AND E.DEPARTMENT_ID IN (
      SELECT DEPARTMENT_ID
      FROM HR.DEPARTMENTS
      WHERE DEPARTMENT_NAME = 'Sales'
  );
