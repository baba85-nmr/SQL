--GROUP BY,JOINS.HAVING
--TASK1
SELECT MANAGER_ID, COUNT(*) AS ISCI_SAYI FROM HR.EMPLOYEES
GROUP BY MANAGER_ID 
ORDER BY COUNT(*) DESC;
--TASK2
SELECT COUNTRY_ID , COUNT(*) AS OFIS_SAYI FROM HR.LOCATIONS
GROUP BY COUNTRY_ID
ORDER BY COUNT(*) DESC;
--TASK3
SELECT E.FIRST_NAME, E.LAST_NAME, J.JOB_TITLE
FROM HR.EMPLOYEES E
INNER JOIN HR.JOBS J ON E.JOB_ID=J.JOB_ID;
--TASK4
SELECT  DEPARTMENT_ID, ROUND(AVG(SALARY),2) AS ORTA_MAAS FROM HR.EMPLOYEES
GROUP BY DEPARTMENT_ID
HAVING AVG(SALARY)>8000;
--TASK5
SELECT DEPARTMENT_ID, COUNT(*) FROM HR.EMPLOYEES
WHERE SALARY>=3000
GROUP BY DEPARTMENT_ID
HAVING COUNT(*)>3;
--TASK6
SELECT J.JOB_TITLE, COUNT(*) AS ISCI_SAYI FROM HR.EMPLOYEES E
JOIN HR.JOBS J ON E.JOB_ID=J.JOB_ID
GROUP BY J.JOB_TITLE;
--TASK7
SELECT L.CITY, L.COUNTRY_ID FROM HR.LOCATIONS L
JOIN HR.DEPARTMENTS D ON L.LOCATION_ID=D.LOCATION_ID
WHERE L.LOCATION_ID IS NOT NULL;
--TASK8 LAST NAME YOX,WHERE YOX HAVING GROUP BY HAVINGDEN EVVEL OLUR
SELECT J.JOB_TITLE, AVG(E.SALARY) AS ORTA_MAAS FROM HR.EMPLOYEES E
JOIN HR.JOBS J ON J.JOB_ID=E.JOB_ID
GROUP BY J.JOB_TITLE
HAVING AVG(E.SALARY)>10000;
--TASK9
SELECT L.CITY, COUNT(*) AS ISC_SAYI, ROUND(AVG(E.SALARY)) AS ORTA_MAAS 
FROM HR.EMPLOYEES E
JOIN HR.DEPARTMENTS D ON D.DEPARTMENT_ID=E.DEPARTMENT_ID
JOIN HR.LOCATIONS L ON L.LOCATION_ID=D.LOCATION_ID
GROUP BY L.CITY
HAVING COUNT(*)>5
ORDER BY COUNT(*) DESC;
--TASK10
SELECT D.DEPARTMENT_NAME, COUNT(*) AS ISCI_SAYI FROM HR.EMPLOYEES E
RIGHT JOIN HR.DEPARTMENTS D ON D.DEPARTMENT_ID=E.DEPARTMENT_ID
GROUP BY D.DEPARTMENT_NAME
ORDER BY ISCI_SAYI DESC, D.DEPARTMENT_NAME ASC;
--NVL,NVL2,CASE WHEN
--TASK1
SELECT FIRST_NAME, LAST_NAME, SALARY,
    CASE 
        WHEN SALARY<6000 THEN 'Asagi'
        WHEN SALARY<=12000 AND SALARY>=6000 THEN 'Orta'
        WHEN SALARY>12000 THEN 'Yuksek'
        END AS MAAS_SEVIYYESI
FROM HR.EMPLOYEES;
--TASK2
SELECT FIRST_NAME, JOB_ID,
                    CASE JOB_ID
                        WHEN 'IT_CLERK' THEN 'Proqramci'
                        WHEN 'SA_REP' THEN 'Satis numayendesi'
                        WHEN 'ST_CLERK' THEN 'Anbar iscisi'
                        ELSE 'Diger'
                        END AS VEZIFE
FROM HR.EMPLOYEES;
--TASK3
SELECT FIRST_NAME, COMMISSION_PCT, NVL2(COMMISSION_PCT,'KOMISIYA VAR','KOMISIYA YOXDUR') FROM HR.EMPLOYEES;
SELECT FIRST_NAME, COMMISSION_PCT,
                                CASE 
                                WHEN COMMISSION_PCT IS NULL THEN 'KOMISSIYA YOXDUR'
                                ELSE 'KOMISIYA VAR'
                                END AS KOMISSIYA_SUTUNU
FROM HR.EMPLOYEES;
--TASK4
SELECT 
    CITY, 
    COUNTRY_ID,
    CASE 
        WHEN COUNTRY_ID IN ('US', 'CA', 'MX', 'BR') THEN 'Amerika'
        WHEN COUNTRY_ID IN ('UK', 'DE', 'IT', 'NL', 'CH') THEN 'Avropa'
        WHEN COUNTRY_ID IN ('JP', 'CN', 'IN', 'SG') THEN 'Asiya'
        ELSE 'Diger'
    END AS QITE
FROM 
    HR.LOCATIONS;
--TASK5
SELECT FIRST_NAME, DEPARTMENT_ID, SALARY,
CASE
    WHEN DEPARTMENT_ID=80 THEN SALARY*0.10
    WHEN DEPARTMENT_ID=60 THEN SALARY*0.15
    ELSE SALARY*0.05
    END AS BONUS
FROM HR.EMPLOYEES;
ORDER BY BONUS DESC;
--TASK6 15 MIN BIRINCI OLMALI IDI,DAR TEMASI,
--ELSE 0 YAZILIB YANLISDI ASAGI OLMALIDI SEVIYYE DIRNAQDA YAZILIB
SELECT FIRST_NAME, SALARY,
        CASE
            WHEN SALARY>15000 THEN 'YUKSEK'
            WHEN SALARY>5000 THEN 'ORTA'
            ELSE 'ASAGI'
        END AS SEVIYYE
FROM HR.EMPLOYEES;
--TASK7
SELECT 
    FIRST_NAME, 
    JOB_ID, 
    MANAGER_ID,
    CASE 
        WHEN MANAGER_ID IS NULL THEN 'Direktor'
        WHEN MANAGER_ID = 100 THEN 'Direktorun komandasi'
        WHEN JOB_ID LIKE '%MAN' OR JOB_ID LIKE '%MGR' THEN 'Menecer'
        ELSE 'Isci'
    END AS ROL
FROM 
    HR.EMPLOYEES;
--TASK8
SELECT NVL(COMMISSION_PCT,0), FIRST_NAME, SALARY, SALARY*NVL(COMMISSION_PCT,0)*12 AS ILLIK_KOMISSIYA, (SALARY*12)+(SALARY*NVL(COMMISSION_PCT,0)*12) AS ILLIK_GELIR FROM HR.EMPLOYEES;
--TASK9
SELECT E.FIRST_NAME, J.JOB_TITLE, E.SALARY, J.MIN_SALARY, J.MAX_SALARY,
            CASE
                WHEN E.SALARY=J.MIN_SALARY THEN 'MINUMUMDA'
                WHEN E.SALARY=J.MAX_SALARY THEN 'MAKSIMUMDA'
                WHEN E.SALARY<(J.MIN_SALARY+J.MAX_SALARY)/2 THEN 'ASAGI YARIDA'
                ELSE 'YUXARI YARIDA'
            END AS MOVQE 
FROM HR.EMPLOYEES E
JOIN HR.JOBS J ON E.JOB_ID=J.JOB_ID;
--TASK10
SELECT E.FIRST_NAME, E.LAST_NAME,NVL(D.DEPARTMENT_NAME,'SOBESIZ') AS SOBE,
                CASE
                    WHEN D.DEPARTMENT_ID IS NULL THEN 'MELUM DEYIL'
                    WHEN L.CITY='SEATTLE' THEN 'BAS OFIS'
                    ELSE 'FILIAL'
                END AS OFIS_SAYI
FROM HR.EMPLOYEES E
LEFT JOIN HR.DEPARTMENTS D ON D.DEPARTMENT_ID=E.DEPARTMENT_ID
LEFT JOIN HR.LOCATIONS L ON D.LOCATION_ID=L.LOCATION_ID;
