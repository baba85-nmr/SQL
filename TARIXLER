--TASK1
SELECT FIRST_NAME || ' ' || UPPER(LAST_NAME) AS TAM_AD , SUBSTR(FIRST_NAME,1,1) || '.' || ' ' || LAST_NAME AS QISA_AD, 
LOWER(EMAIL) || '@company.com' AS EMAIL FROM HR.EMPLOYEES;
--TASK2 METN TIPINDE OLDUGU UCUN MAAS DESC YAZMADIQ
SELECT FIRST_NAME, TO_CHAR(SALARY, 'FM99,999') || ' AZN' AS MAAS,TO_CHAR(SALARY*12,'FM999,999.00') AS ILLIK_MAAS
FROM HR.EMPLOYEES
ORDER BY SALARY DESC;
--TASK3
SELECT FIRST_NAME, TO_CHAR(HIRE_DATE,'DD.MM.YYYY') AS ISE_GIRIS, EXTRACT(YEAR FROM HIRE_DATE) AS IL,TO_CHAR(HIRE_DATE,'FMMONTH') AS AY_ADI,
TO_CHAR(HIRE_DATE,'FMDAY') AS HEFTE_GUNU
FROM HR.EMPLOYEES
ORDER BY HIRE_DATE ASC;
--TASK4
SELECT FIRST_NAME || LAST_NAME, TO_CHAR(HIRE_DATE, 'FMDD.MONTH.YYYY') AS ISE_GIRIS,
TRUNC(MONTHS_BETWEEN(SYSDATE,HIRE_DATE)/12)|| ' ' || 'IL' || TRUNC(MOD(MONTHS_BETWEEN(SYSDATE,HIRE_DATE),12)) || 'AY'
AS STAJ FROM HR.EMPLOYEES
ORDER BY HIRE_DATE DESC;
--TASK5
SELECT FIRST_NAME, HIRE_DATE, ADD_MONTHS(HIRE_DATE,3) AS SINAQ_BITIR, LAST_DAY(HIRE_DATE) AS ILK_MAAS_GUNU, 
LAST_DAY(HIRE_DATE)-HIRE_DATE AS MAAS_QALAN_GUN FROM HR.EMPLOYEES;
--TASK6
SELECT CONCAT(FIRST_NAME,LAST_NAME) || ',' || 'KOMISSIYA:' || NVL(TO_CHAR(COMMISSION_PCT,'FM0.00'),'YOXDUR')
FROM HR.EMPLOYEES
WHERE EXTRACT (MONTH FROM HIRE_DATE)=03;
--TASK7
SELECT TO_CHAR(HIRE_DATE, 'MONTH') AS AY, TO_CHAR(HIRE_DATE,'MM') AS AY_NO, COUNT(*)
FROM HR.EMPLOYEES
GROUP BY TO_CHAR(HIRE_DATE, 'MONTH'), TO_CHAR(HIRE_DATE,'MM')
ORDER BY AY_NO
--TASK8
SELECT EMPLOYEE_ID,LOWER(SUBSTR(FIRST_NAME, 1, 1) || LAST_NAME) || LPAD(EMPLOYEE_ID, 4, '0') AS LOGIN,
REPLACE(PHONE_NUMBER, '.', '-') AS TELEFON
FROM HR.EMPLOYEES
WHERE LENGTH(LAST_NAME) >= 7
ORDER BY LOGIN;
--TASK9
SELECT 
    EXTRACT(YEAR FROM HIRE_DATE) AS IL,
    COUNT(*) AS ISCI_SAYI,
    TO_CHAR(MIN(HIRE_DATE), 'DD.MM.YYYY') AS ILK_TARIX,
    TO_CHAR(MAX(HIRE_DATE), 'DD.MM.YYYY') AS SON_TARIX,
    TO_CHAR(AVG(SALARY), 'FM999,999.00') AS ORTA_MAAS
FROM HR.EMPLOYEES
GROUP BY EXTRACT(YEAR FROM HIRE_DATE)
ORDER BY IL ASC;
--TASK10
--a
SELECT TO_CHAR(HIRE_DATE,'Dy') || ',' || TO_CHAR(HIRE_DATE,'DD.MM.YYYY'),
CASE
    WHEN TO_CHAR(HIRE_DATE,'Dy')='Sun' THEN 'HEFTESONU'
    WHEN TO_CHAR(HIRE_DATE,'Dy')='Sat' THEN 'HEFTESONU'
    ELSE 'ISGUNU'
    END AS GUN_NOVU
FROM HR.EMPLOYEES
--b
SELECT TRIM(TO_CHAR(HIRE_DATE,'DAY')), COUNT(*) FROM HR.EMPLOYEES
GROUP BY TRIM(TO_CHAR(HIRE_DATE,'DAY'))
ORDER BY COUNT(*)DESC
