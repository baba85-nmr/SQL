--TASK1
SELECT FIRST_NAME, LAST_NAME, HIRE_DATE ,
                                CASE
                                    WHEN HIRE_DATE<TO_DATE('2003-01-01','YYYY-MM-DD') THEN 'VETERAN'
                                    WHEN HIRE_DATE BETWEEN TO_DATE('2003-01-01','YYYY-MM-DD') AND TO_DATE('2006-12-31','YYYY-MM-DD') THEN 'TECRUBELI'
                                    ELSE 'YENI'
                                    END AS STAJ_QRUPU
                                    FROM HR.EMPLOYEES;
--TASK2
SELECT DEPARTMENT_NAME, DEPARTMENT_ID, CASE DEPARTMENT_NAME
                                            WHEN 'Administration' then 'Idareetme'
                                            WHEN 'Marketing' then 'Marketing'
                                            WHEN 'Purchasing' then 'Satinalma'
                                            WHEN 'Human Resources' then 'Insan resusrlari'
                                            ELSE 'DIGER SOBE'
                                            END AS SOBE_AZ
FROM HR.DEPARTMENTS;
--TASK3
SELECT FIRST_NAME, DEPARTMENT_ID, CASE
WHEN DEPARTMENT_ID IS NULL THEN 'SOBE TEYIN OLUNMUYUB'
ELSE 'SOBE TEYIN OLUNUB'
END AS SOBE_STATUSU
FROM HR.EMPLOYEES;
SELECT FIRST_NAME,DEPARTMENT_ID, NVL2(DEPARTMENT_ID,'SOBE VAR','SOBE YOXDU') FROM HR.EMPLOYEES;
--TASK4
SELECT JOB_ID,JOB_TITLE,CASE 
WHEN JOB_ID IN( 'AD_VP', 'FI_MGR', 'AC_MGR') THEN 'ALIREHBERLIK'
WHEN JOB_ID IN( 'SA_REP', 'FI_ACCOUNT') THEN 'ESASMUTEXESSIZ'
WHEN JOB_ID IN( 'ST_CLERK', 'SH_CLERK', 'PU_CLERK' ) THEN 'OPERATIV ISCI'
ELSE 'DIGER'
END AS KATEQORIYA
FROM HR.JOBS;
--TASK5
SELECT FIRST_NAME, DEPARTMENT_ID, SALARY, CASE DEPARTMENT_ID
WHEN 50 THEN SALARY*0.08
WHEN 30 THEN SALARY*0.12
WHEN 100 THEN 400
ELSE SALARY*0.04
END AS MUAVINET
FROM HR.EMPLOYEES
ORDER BY MUAVINET DESC;
--TASK6
SELECT FIRST_NAME, COMMISSION_PCT,CASE
WHEN COMMISSION_PCT IS NULL THEN 'YOXDUR'
WHEN COMMISSION_PCT>0.25 THEN 'YUKSEK KOMMISIYA'
ELSE 'NORMAL KOMMISIYA'
END AS KOMMISIYA_NOVU
FROM HR.EMPLOYEES;
--TASK7
SELECT FIRST_NAME, PHONE_NUMBER, SALARY, CASE 
WHEN PHONE_NUMBER LIKE '_515%' THEN 'DAXILI XETT'
WHEN SALARY>=10000 THEN 'YUKSEK MAAS'
WHEN COMMISSION_PCT IS NOT NULL THEN 'SATIS KOMANDASI'
ELSE 'STANDART ISCI'
END AS KATEQORIYA
FROM HR.EMPLOYEES
--TASK8
SELECT FIRST_NAME,SALARY,COMMISSION_PCT,NVL(SALARY * COMMISSION_PCT * 3, 0) AS RUBLUK_BONUS,(SALARY * 3) + NVL(SALARY * COMMISSION_PCT * 3, 0) AS RUBLUK_UMUMI
FROM HR.EMPLOYEES
ORDER BY RUBLUK_UMUMI ASC;
--TASK9
SELECT E.FIRST_NAME, J.JOB_TITLE, E.SALARY, J.MIN_SALARY, J.MAX_SALARY, CASE
WHEN E.SALARY=J.MAX_SALARY THEN 'LIMITE CATIB'
WHEN J.MAX_SALARY-E.SALARY=2000 THEN 'LIMITE COX YAXIN'
WHEN SALARY<MIN_SALARY+1000 THEN 'BASLANGIC SEVIYYE'
ELSE 'ORTA ARALIQDA'
END AS MAAS_VEZIYYETI
FROM HR.EMPLOYEES E
JOIN HR.JOBS J ON E.JOB_ID=J.JOB_ID;
--TASK10
SELECT E.FIRST_NAME, E.LAST_NAME, NVL2(D.MANAGER_ID,'REHBER VAR','REHBER YOXDU') AS MENECER_STATUS,CASE
WHEN E.DEPARTMENT_ID IS NULL THEN 'TEYIN EDILMEYIB'
WHEN L.COUNTRY_ID='US' THEN 'ABS OFISI'
ELSE 'BEYNELXALQ OFIS'
END AS REGION 
FROM HR.EMPLOYEES E 
LEFT JOIN HR.DEPARTMENTS D ON E.DEPARTMENT_ID=D.DEPARTMENT_ID
LEFT JOIN HR.LOCATIONS L ON D.LOCATION_ID=L.LOCATION_ID;
--TASK2
SELECT  e.FIRST_NAME,e.LAST_NAME,NVL(m.FIRST_NAME, 'Yoxdur') AS MENECER_ADI,NVL(m.LAST_NAME, 'Yoxdur')  AS MENECER_SOYADI
FROM HR.EMPLOYEES e
LEFT JOIN HR.EMPLOYEES m ON e.MANAGER_ID = m.EMPLOYEE_ID;
--TASK3
SELECT DEPARTMENT_ID, DEPARTMENT_NAME, LOCATION_ID FROM HR.DEPARTMENTS
WHERE LOCATION_ID IN(SELECT LOCATION_ID FROM HR.LOCATIONS
                        WHERE COUNTRY_ID='GB' )
--TASK4
SELECT E.FIRST_NAME, E.LAST_NAME, E.SALARY FROM HR. EMPLOYEES E 
JOIN HR.EMPLOYEES M ON M.EMPLOYEE_ID=E.MANAGER_ID
WHERE M.FIRST_NAME='Neena' AND M.LAST_NAME='Kochhar';  
--TASK5
SELECT E.FIRST_NAME, E.LAST_NAME,E.HIRE_DATE, M.FIRST_NAME AS MENECER_AD, M.HIRE_DATE AS MENECER_TARIX FROM HR.EMPLOYEES E
JOIN HR.EMPLOYEES M ON E.MANAGER_ID=M.EMPLOYEE_ID
WHERE M.HIRE_DATE>E.HIRE_DATE;
--TASK6
SELECT E.FIRST_NAME, E.LAST_NAME, E.JOB_ID, M.FIRST_NAME AS MENECER_AD, M.LAST_NAME AS MENECER_SOYADI FROM HR.EMPLOYEES E
JOIN HR.EMPLOYEES M ON E.MANAGER_ID=M.EMPLOYEE_ID
WHERE M.JOB_ID=E.JOB_ID;
--TASK7
SELECT FIRST_NAME, LAST_NAME, JOB_ID, SALARY FROM HR.EMPLOYEES
WHERE JOB_ID IN (SELECT JOB_ID FROM HR.JOBS
WHERE MAX_SALARY>15000);
--TASK8 = isaresi yox in yazilmalidi subquery de 2 sutun olmaz swtwn adi sehv yazilib it ve finance order by da istletmek olmaz
SELECT FIRST_NAME, SALARY FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IN (SELECT DEPARTMENT_ID FROM HR.DEPARTMENTS
WHERE DEPARTMENT_NAME IN('IT','Finance'));
--TASK9**
SELECT EMPLOYEE_ID, FIRST_NAME, LAST_NAME FROM HR.EMPLOYEES
WHERE EMPLOYEE_ID NOT IN (SELECT MANAGER_ID FROM HR.EMPLOYEES
WHERE MANAGER_ID IS NOT NULL);
--TASK10
SELECT 
    m.FIRST_NAME AS MENECER_ADI,
    m.LAST_NAME AS MENECER_SOYADI,
    MAX(e.SALARY) AS MAX_TABE_MAASI,
    MIN(e.SALARY) AS MIN_TABE_MAASI
FROM 
    HR.EMPLOYEES e
JOIN 
    HR.EMPLOYEES m ON e.MANAGER_ID = m.EMPLOYEE_ID
GROUP BY 
    m.EMPLOYEE_ID, 
    m.FIRST_NAME, 
    m.LAST_NAME
HAVING 
    AVG(e.SALARY) > 7000
ORDER BY 
    MAX_TABE_MAASI DESC;
